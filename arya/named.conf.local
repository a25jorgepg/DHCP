key "chave-stark" {
        algorithm hmac-sha256;
        secret "vTDFBXC5M44F9MkwOwZHcLKzK2xLTmXzDJj5y49elfs=";
};

// Rede Stark.lan

zone "stark.lan" {
	type primary;
    file "zonas/db.stark.lan";
    allow-update{key "chave-stark";};
};

